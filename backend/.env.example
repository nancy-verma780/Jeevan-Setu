# Copy to .env and adjust. Every setting uses the JS_ prefix.
JS_ENV=dev
JS_DATABASE_URL=sqlite:///./jeevansetu.db
# JS_DATABASE_URL=postgresql+psycopg://jeevansetu:password@localhost:5432/jeevansetu
JS_COOKIE_SECURE=false
JS_EXPOSE_DEV_OTP=true
JS_OTP_PEPPER=replace-with-a-long-random-string
JS_REPLY_TIMEOUT_SECONDS=120
JS_CORS_ORIGINS=["http://localhost:5173"]
